{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eoes",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The worker must see every request so it can 301 the apex to www;
    // for everything else it just hands off to the asset binding.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Custom domains. These need the eoes.co.uk zone to be active on this
  // Cloudflare account before `wrangler deploy` will accept them — see MIGRATION.md.
  "routes": [
    { "pattern": "www.eoes.co.uk", "custom_domain": true },
    { "pattern": "eoes.co.uk", "custom_domain": true }
  ]
}
