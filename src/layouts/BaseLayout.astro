---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /** Exact <title>; otherwise "title | East of England Summit". */
  fullTitle?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  pageType?: 'website' | 'article';
}

const {
  title,
  fullTitle: fullTitleProp,
  description = 'East of England Summit — returning 30 April–1 May 2027. A community-led conference covering the whole Microsoft stack: AI and Copilot, Fabric, Azure, Dynamics 365, Microsoft 365 and Power Platform. Based in Norwich, Norfolk.',
  canonical = Astro.url.href,
  noindex = false,
  ogImage = 'https://www.eoes.co.uk/images/og-card.png',
  pageType = 'website',
} = Astro.props;

const siteName = 'East of England Summit';
const fullTitle = fullTitleProp ?? (title === 'Home' ? siteName : `${title} | ${siteName}`);

const SITE = 'https://www.eoes.co.uk/';
const ORG_ID = `${SITE}#organization`;
const WEBSITE_ID = `${SITE}#website`;
const VENUE_ID = `${SITE}#venue`;
const TICKET_URL = 'https://app.eoes.co.uk/e/eoes-2027/register';

// Every page: who runs the event, and the site itself.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'East of England Summit',
      alternateName: ['EoES', 'East of England Power Platform Summit', 'EoEPPS'],
      legalName: 'East of England Tech Community Ltd',
      url: SITE,
      logo: `${SITE}images/Logo.png`,
      email: 'info@eoes.co.uk',
      identifier: { '@type': 'PropertyValue', propertyID: 'Companies House company number', value: '16951004' },
      sameAs: [
        'https://www.linkedin.com/company/eoes/',
        'https://sessionize.com/east-of-england-summit-2027',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      url: SITE,
      name: 'East of England Summit',
      inLanguage: 'en-GB',
      publisher: { '@id': ORG_ID },
    },
  ],
};

const isHomepage = Astro.url.pathname === '/';
const breadcrumbSchema = !isHomepage && !noindex ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
} : null;

// Homepage only. Times and the +01:00 (BST) offset come from the schedule page:
// workshops 09:00 to 16:30, conference 08:00 to 17:30.
const eventImages = [`${SITE}images/og-card.png`, `${SITE}images/logo-hero.png`];
const freeOffer = {
  '@type': 'Offer',
  name: 'Free conference ticket',
  price: '0',
  priceCurrency: 'GBP',
  availability: 'https://schema.org/InStock',
  url: TICKET_URL,
};
const eventSchema = isHomepage ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  '@id': `${SITE}#event-2027`,
  name: 'East of England Summit 2027',
  alternateName: 'EoES 2027',
  description: 'The East of England Summit (EoES), a volunteer-run community conference covering the whole Microsoft stack and AI: Copilot, Fabric, Azure, Dynamics 365, Microsoft 365 and Power Platform. 30 April to 1 May 2027 at The Space, Norwich.',
  url: SITE,
  startDate: '2027-04-30T09:00:00+01:00',
  endDate: '2027-05-01T17:30:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'en-GB',
  location: {
    '@type': 'Place',
    '@id': VENUE_ID,
    name: 'The Space',
    url: 'https://thespacenorwich.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Roundtree Way',
      addressLocality: 'Norwich',
      addressRegion: 'Norfolk',
      postalCode: 'NR7 8SQ',
      addressCountry: 'GB',
    },
    // Map pin from the venue's own contact page (thespacenorwich.com/contact).
    geo: { '@type': 'GeoCoordinates', latitude: 52.6489039, longitude: 1.3262261 },
  },
  organizer: { '@id': ORG_ID },
  image: eventImages,
  offers: freeOffer,
  keywords: 'Microsoft, AI, Copilot, Microsoft Fabric, Azure, Dynamics 365, Microsoft 365, Power Platform, Power Apps, Power Automate, Power BI, Norwich, Norfolk, East of England, conference, summit, 2027',
  subEvent: [
    {
      '@type': 'Event',
      '@id': `${SITE}#workshop-day`,
      name: 'EoES 2027 Workshop Day',
      description: 'Small-group, instructor-led hands-on workshops. Paid ticket, limited places, lunch included. Bring your laptop.',
      url: `${SITE}workshops/`,
      startDate: '2027-04-30T09:00:00+01:00',
      endDate: '2027-04-30T16:30:00+01:00',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@id': VENUE_ID },
      organizer: { '@id': ORG_ID },
      image: eventImages,
    },
    {
      '@type': 'Event',
      '@id': `${SITE}#conference-day`,
      name: 'EoES 2027 Conference Day',
      description: 'Free conference day with a keynote, parallel tracks, a sponsor exhibition, lunch and networking.',
      url: `${SITE}schedule/`,
      startDate: '2027-05-01T08:00:00+01:00',
      endDate: '2027-05-01T17:30:00+01:00',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      isAccessibleForFree: true,
      location: { '@id': VENUE_ID },
      organizer: { '@id': ORG_ID },
      image: eventImages,
      offers: freeOffer,
    },
  ],
} : null;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo-180.png" />

    <meta name="generator" content={Astro.generator} />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Norwich, Norfolk`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteName} — Norwich, Norfolk`} />

    <title>{fullTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {eventSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Umami Analytics (cookieless — no consent banner required) -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="9a32fa67-717f-4e5e-a855-ee5ddb7dda91"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
