---
// Sessionize's embed creates its own #sz-modal-container and shows/hides it with
// .is-hidden. This makes it behave like a dialog: focus moves in, the rest of the
// page goes inert, Escape closes it, and focus returns to whatever opened it.
---
<script is:inline>
  // Pages that render the Sessionize lists at build time do not load the embed
  // script, so define the one function their markup calls (onclick="return
  // sessionize.showModal(...)"). Same request the embed makes. Where the embed
  // script did load (schedule, or the fallback), its own showModal is kept.
  window.sessionize = window.sessionize || {};
  if (!window.sessionize.showModal) {
    window.sessionize.showModal = function (id, type, itemId) {
      var box = document.getElementById('sz-modal-container');
      if (!box) return false;
      box.innerHTML = '<div class="sz-modal-overlay"><div class="sz-spinner"></div></div>';
      box.classList.remove('is-hidden');
      fetch('https://sessionize.com/api/v2/' + id + '/' + type + '?id=' + encodeURIComponent(itemId), { method: 'POST' })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
        .then(function (html) {
          box.innerHTML = html;
          box.querySelectorAll('.sz-modal__close-on-click').forEach(function (el) {
            el.onclick = function () { box.classList.add('is-hidden'); };
          });
        })
        .catch(function () { box.classList.add('is-hidden'); });
      return false;
    };
  }

  (function () {
    var modal = null;
    var opener = null;

    // Inert every sibling of the modal and of each of its ancestors, so the modal
    // stays usable wherever Sessionize put it.
    function setInert(on) {
      for (var el = modal; el && el.parentElement; el = el.parentElement) {
        Array.prototype.forEach.call(el.parentElement.children, function (sib) {
          if (sib !== el) sib.inert = on;
        });
        if (el.parentElement === document.body) break;
      }
    }

    // Runs on open/close (class) and when the content swaps, e.g. session -> speaker.
    function sync() {
      var open = document.querySelector('#sz-modal-container:not(.is-hidden)');
      if (open) {
        if (!modal) {
          modal = open;
          opener = document.activeElement;
          modal.setAttribute('role', 'dialog');
          modal.setAttribute('aria-modal', 'true');
          setInert(true);
        }
        var heading = modal.querySelector('h2, h3');
        if (heading) modal.setAttribute('aria-label', heading.textContent.trim());
        var close = modal.querySelector('.sz-modal__close');
        if (close) {
          close.setAttribute('aria-label', 'Close');
          if (!modal.contains(document.activeElement)) close.focus();
        }
      } else if (modal) {
        setInert(false);
        modal = null;
        if (opener && opener.focus) opener.focus();
        opener = null;
      }
    }

    new MutationObserver(sync).observe(document.body, {
      attributes: true, attributeFilter: ['class'], childList: true, subtree: true,
    });

    // Sessionize only adds its close button once the content has loaded. If the request
    // fails there is no button, so hide the container ourselves rather than leave the page inert.
    function dismiss() {
      var close = modal.querySelector('.sz-modal__close');
      if (close) close.click();
      else modal.classList.add('is-hidden');
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal) dismiss();
    });
    document.addEventListener('click', function (e) {
      if (modal && e.target.classList && e.target.classList.contains('sz-modal-overlay') && !modal.querySelector('.sz-modal__close')) dismiss();
    });
  })();
</script>
